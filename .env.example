# Origem do backend, sem /api, só servidor (usada pelo rewrites() do Next; nunca NEXT_PUBLIC_)
API_INTERNAL_URL=http://localhost:3000

# Seleção de marca: valor público (vai para o bundle do browser), sem segredo.
# Ausente ou vazia seleciona a marca padrão; só "exemplo" (exato) seleciona a
# marca fictícia; qualquer outro valor recusa a publicação.
# NEXT_PUBLIC_MARCA=exemplo

# Ambiente
NODE_ENV=development